# ==============================================================================
# Master .gitignore for Full-Stack Project (Frontend & Backend)
# ==============================================================================

# Dependencies (Root, Frontend, Backend)
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
*/.next/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Vercel & Deployment Artifacts
.vercel/
*/.vercel/
.turbo/
*/.turbo/

# Logs
logs/
*.log
*/logs/
*/src/logs/*.log

# Backend specific
uploads/
*/uploads/
*.js.map
*/dist/**/*.map

# Database & Prisma local files
*.sqlite
*.sqlite3
*.db
prisma/*.db

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db